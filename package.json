{
  "name": "field-plugin-monorepo-template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "add-plugin": "npx @storyblok/field-plugin-cli@beta add --dir \"./packages\" --structure monorepo --packageManager pnpm",
    "lint": "eslint --ext .js,.vue .",
    "format": "prettier . --write"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "5.45.0",
    "@typescript-eslint/parser": "5.45.0",
    "@vue/eslint-config-prettier": "7.0.0",
    "@vue/eslint-config-typescript": "11.0.2",
    "eslint": "8.28.0",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.8.0",
    "typescript": "4.6.4",
    "vite": "^6.4.5"
  },
  "packageManager": "pnpm@12.12.0+sha512.2ee06ac86db554cf384421461220f0e336a487bfd41b2acd04e17a86b1487832fe45e8d1743f7fc52acc77de12d2356b536fedf8229fc483239e40b13d474449"
